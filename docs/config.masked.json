{
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "/var/log/sing-box/sing-box.log"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-in",
      "listen": "::",
      "listen_port": 8443,
      "users": [
        {
          "uuid": "<REDACTED>",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.microsoft.com",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.microsoft.com",
            "server_port": 443
          },
          "private_key": "<REDACTED>",
          "short_id": [
            "<REDACTED>"
          ]
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2-in",
      "listen": "::",
      "listen_port": 4443,
      "users": [
        {
          "password": "<REDACTED>"
        }
      ],
      "masquerade": "https://www.microsoft.com",
      "tls": {
        "enabled": true,
        "alpn": [
          "h3"
        ],
        "certificate_path": "/opt/certs/fullchain.pem",
        "key_path": "/opt/certs/privkey.pem"
      }
    },
    {
      "type": "trojan",
      "tag": "trojan-in",
      "listen": "::",
      "listen_port": 13159,
      "users": [
        {
          "password": "<REDACTED>"
        }
      ],
      "tls": {
        "enabled": true,
        "alpn": [
          "h2",
          "http/1.1"
        ],
        "certificate_path": "/opt/certs/fullchain.pem",
        "key_path": "/opt/certs/privkey.pem"
      }
    },
    {
      "type": "shadowsocks",
      "tag": "ss2022-in",
      "listen": "::",
      "listen_port": 2096,
      "method": "2022-blake3-aes-128-gcm",
      "password": "<REDACTED>"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": [
          "bittorrent"
        ],
        "outbound": "block"
      }
    ]
  },
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "ts-ep",
      "hostname": "deb-aws-tk",
      "accept_routes": true,
      "state_directory": "/var/lib/sing-box/tailscale"
    }
  ],
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9999",
      "secret": "<REDACTED>",
      "default_mode": "rule",
      "external_ui": "/var/lib/sing-box/ui"
    },
    "cache_file": {
      "enabled": true,
      "path": "/var/lib/sing-box/cache.db",
      "store_dns": true
    }
  },
  "services": [
    {
      "type": "api",
      "tag": "api",
      "listen": "0.0.0.0",
      "listen_port": 9091,
      "secret": "<REDACTED>",
      "dashboard": true,
      "access_control_allow_private_network": true
    }
  ],
  "_note": "masked copy: all credentials replaced, structure only"
}
